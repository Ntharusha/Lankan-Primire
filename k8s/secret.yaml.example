apiVersion: v1
kind: Secret
metadata:
  name: lankan-primire-secret
  namespace: lankan-primire
type: Opaque
stringData:
  MONGODB_URI: "mongodb+srv://username:password@cluster.mongodb.net/lankan_primire?retryWrites=true&w=majority"
  JWT_SECRET: "your-production-super-secret-jwt-key"
  STRIPE_SECRET_KEY: "sk_test_example"
